{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://raw.githubusercontent.com/rin00159/hash-record-schema/refs/heads/main/schema/0.0.0/hash-record.schema.json",
	"type": "object",
	"title": "Hash Record",
	"description": "データに対応するハッシュ値のレコード。キーはハッシュ種別(暗号学的ハッシュは CycloneDX、非暗号学的ハッシュは SPDX の表記に準拠)、値は小文字の16進数。未定義の種別も許可するが、キーは大文字表記(BLAKE2b / BLAKE2s のみ小文字を含む)に限る",
	"propertyNames": {
		"pattern": "^(?:BLAKE2[bs]|[A-Z0-9]+)(?:-[A-Z0-9]+)*(?:/[A-Z0-9]+)?$"
	},
	"properties": {
		"MD4": {
			"type": "string",
			"pattern": "^[a-f0-9]{32}$",
			"description": "レガシー。新規採用は非推奨"
		},
		"MD5": {
			"type": "string",
			"pattern": "^[a-f0-9]{32}$",
			"description": "レガシー。暗号用途には非推奨"
		},
		"RIPEMD-160": {
			"type": "string",
			"pattern": "^[a-f0-9]{40}$",
			"description": "レガシー"
		},
		"SHA-1": {
			"type": "string",
			"pattern": "^[a-f0-9]{40}$",
			"description": "衝突攻撃が実証済みのため新規採用は非推奨"
		},
		"SHA-256": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"SHA-384": {
			"type": "string",
			"pattern": "^[a-f0-9]{96}$"
		},
		"SHA-512": {
			"type": "string",
			"pattern": "^[a-f0-9]{128}$"
		},
		"SHA-512/256": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"SHA3-256": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"SHA3-384": {
			"type": "string",
			"pattern": "^[a-f0-9]{96}$"
		},
		"SHA3-512": {
			"type": "string",
			"pattern": "^[a-f0-9]{128}$"
		},
		"BLAKE2b-256": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"BLAKE2b-384": {
			"type": "string",
			"pattern": "^[a-f0-9]{96}$"
		},
		"BLAKE2b-512": {
			"type": "string",
			"pattern": "^[a-f0-9]{128}$"
		},
		"BLAKE2s-256": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"BLAKE3": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"SM3": {
			"type": "string",
			"pattern": "^[a-f0-9]{64}$"
		},
		"CRC32-ISO3309": {
			"type": "string",
			"pattern": "^[a-f0-9]{8}$",
			"description": "多項式 0x04C11DB7(ZIP, gzip, PNG 等)"
		},
		"CRC32-C": {
			"type": "string",
			"pattern": "^[a-f0-9]{8}$",
			"description": "Castagnoli 多項式 0x1EDC6F41(iSCSI, RFC 3720)"
		},
		"ADLER32": {
			"type": "string",
			"pattern": "^[a-f0-9]{8}$"
		},
		"XXH32": {
			"type": "string",
			"pattern": "^[a-f0-9]{8}$"
		},
		"XXH64": {
			"type": "string",
			"pattern": "^[a-f0-9]{16}$"
		},
		"XXH3-64": {
			"type": "string",
			"pattern": "^[a-f0-9]{16}$"
		},
		"XXH3-128": {
			"type": "string",
			"pattern": "^[a-f0-9]{32}$"
		}
	}
}
